# ==============================================================================
# COGLEARN Platform Environment Configuration
# ==============================================================================

# Application Environment (development | production | testing)
ENVIRONMENT=development

# Multi-tenant and Platform Settings
MIN_COHORT_SIZE=5

# Database Configuration (Async PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://coglearn:coglearn_dev_password@postgres:5432/coglearn

# Redis Configuration (Broker and Caching)
REDIS_URL=redis://redis:6379/0

# Celery Task Queue
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Storage Settings
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/app/uploads

# CORS Settings (JSON list of origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:8000"]

# ------------------------------------------------------------------------------
# Asymmetric RS256 JWT Authentication Configuration
#
# Generate RSA keypair with OpenSSL:
#   1. Generate private key:
#      openssl genrsa -out jwt_private.pem 2048
#   2. Extract public key:
#      openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
#   3. Convert PEM files to single-line or multiline string in .env:
#      In Python .env files, newlines can be preserved with standard quotes or \n.
# ------------------------------------------------------------------------------
SECRET_KEY=coglearn_super_secret_development_hmac_fallback_key_32_bytes_min

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# RSA Private Key (PEM format) - Replace with actual production key
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA0s4b8V5hPzJgQyE8T+1zO1vV5r8K...Example...\n-----END RSA PRIVATE KEY-----"

# RSA Public Key (PEM format) - Replace with actual production key
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA0s4b8V5hPzJgQyE8T...\n-----END PUBLIC KEY-----"

# Platform Initial Admin Account
PLATFORM_ADMIN_EMAIL=admin@coglearn.internal
PLATFORM_ADMIN_PASSWORD=AdminSecurePassword123!

# SMTP / Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@coglearn.internal
SMTP_PASSWORD=your_smtp_app_password_here
SMTP_FROM_EMAIL=notifications@coglearn.internal
SMTP_FROM_NAME="COGLEARN Notifications"
